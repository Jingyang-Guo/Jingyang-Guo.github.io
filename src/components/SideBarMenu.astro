---
const { sideBarActiveItemID } = Astro.props;
const activeClass = "bg-base-300"; // For primary color replace with `active` class
---

<ul class="menu grow shrink menu-md overflow-y-auto">
    <li><a class:list={["py-3 text-base", sideBarActiveItemID === "home" && activeClass]} id="home" href="/" data-astro-reload>Home</a></li>
    <li><a class:list={["py-3 text-base", sideBarActiveItemID === "research" && activeClass]} id="research" href="/research/" data-astro-reload>Research</a></li>
    <li><a class:list={["py-3 text-base", sideBarActiveItemID === "services" && activeClass]} id="services" href="/services/" data-astro-reload>Services</a></li>
    <li><a class:list={["py-3 text-base", sideBarActiveItemID === "blog" && activeClass]} id="blog" href="/blog/" data-astro-reload>Blog</a></li>
    <li><a class:list={["py-3 text-base", sideBarActiveItemID === "cv" && activeClass]} id="cv" href="/cv/" data-astro-reload>CV</a></li>
</ul>
